# GastoControl — backend OCR (FastAPI) como servicio systemd
# Sustituye __USER__, __APP_DIR__ y __OCR_PORT__.
[Unit]
Description=GastoControl OCR backend (FastAPI, OCR-only)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/backend
EnvironmentFile=__APP_DIR__/backend/.env
ExecStart=__APP_DIR__/backend/.venv/bin/uvicorn server:app --host 127.0.0.1 --port __OCR_PORT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
