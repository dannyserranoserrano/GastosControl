# ===== GastoControl — variables de entorno =====
# Copia este archivo a `.env` y rellena los valores.

# Backend opcional (FastAPI). Déjalo vacío para usar el modo local (IndexedDB).
VITE_BACKEND_URL=

# Opcional: clave compartida con el backend OCR (APP_API_KEY). Si el backend la exige,
# el frontend la envía en la cabecera X-App-Key al escanear tickets.
VITE_OCR_KEY=

# Opcional: CAPTCHA de Cloudflare Turnstile. Si se define, el login/registro muestra el
# widget y envía el token. Requiere activar Turnstile en Supabase (Authentication) con el
# mismo par de claves (site key aquí / secret key en Supabase). Vacío = sin CAPTCHA.
VITE_TURNSTILE_SITE_KEY=

# Supabase Auth + persistencia (opcional). Crea un proyecto en https://supabase.com
# y copia aquí la "Project URL" y la "anon public key".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=