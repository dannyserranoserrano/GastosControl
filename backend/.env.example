# ===== GastoControl — backend (FastAPI) =====
# Copia este archivo a `backend/.env` y rellena los valores. NO subir `.env` a git.

# MongoDB opcional. Sin MONGO_URL el backend arranca en modo OCR-only
# (solo /api/receipts/scan y /api/files/*); las rutas de datos devuelven 503.
MONGO_URL=
DB_NAME=gastocontrol

# Orígenes permitidos por CORS (separados por coma). Lista blanca, no usar "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Clave de IA para el OCR (usa una de las dos; Gemini directo tiene prioridad).
EMERGENT_LLM_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Endurecimiento ---
# Clave compartida: si se define, /api/receipts/scan y /api/files exigen la
# cabecera `X-App-Key` con este valor. El frontend la envía si defines VITE_OCR_KEY.
APP_API_KEY=
# Tamaño máximo de subida en bytes (8 MB por defecto).
MAX_UPLOAD_BYTES=8388608
# Máximo de peticiones por minuto y por IP en OCR/ficheros (0 = sin límite).
OCR_RATE_LIMIT=30
